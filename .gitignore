cross-engine-graph/corpus/
cross-engine-graph/graphify-out/cache/
cross-engine-graph/**/graphify-out/cache/
cross-engine-graph/**/graphify-out/20??-??-??/
cross-engine-graph/graphify_run.log
/reference/build/
**/__pycache__/

# Belt-and-braces: the real key lives in %LOCALAPPDATA%\graphify\ (outside any
# repo), but never let a stray secret file land here either.
*.key
*.env
.env*
secrets*
*secret*
site-public/
# Local intake contains project-owned artifact paths; publish the reviewed digest.
/research-inbox/pending/
/research-inbox/reviews/
/External/

# graphify query-feedback loop: per-machine learning signal, not shared state
cross-engine-graph/graphify-out/.graphify_learning.json
cross-engine-graph/graphify-out/reflections/
# Verbatim proprietary game/engine files extracted from a shipping build.
# Retail evidence packs can hold configuration files extracted directly
# from shipping archives. NOTICE.md excludes game assets and
# engine SDKs from version control, and this repository is public, so the
# extraction stays local. Findings may be described; the files may not ship.
briefs/evidence/*-retail-*/

# Internal working corpus. Ignoring does not remove already tracked files or
# historical commits. Publication requires the separate privacy gate.
/.publication-private/
/cross-engine-graph/
/briefs/
/CLAUDE_CHAT_HANDOFF.md
/HANDOFF_TO_CODEX.md
/AGENT_GUIDANCE_AUDIT_*.md
/tools/Repowise-*.ps1
/tools/repowise-*.md
/tools/repowise_workflow.py
/tools/test_repowise_workflow.py
/tools/analyse-doc-split.py
/tools/reconcile_fleet.py
/tools/reconcile_graphs.py

# Per-developer assistant tooling, not project configuration. `graphify install
# --platform opencode` writes a tool.execute.before hook here; the claude and
# codex targets install to ~/.claude and ~/.codex instead, so only this one lands
# in the repo. It is also inert here - it guards on <root>/graphify-out/graph.json
# and this repo's graph lives under cross-engine-graph/. There is no .claude/
# either, for the same reason: a public cross-engine playbook should not ship one
# assistant's hooks.
/.opencode/
